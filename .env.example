# Copy to .env before `docker compose up`.
#   cp .env.example .env
#
# .env is gitignored. Values below are local-development defaults only.

# --- Host ports (published by Compose) ---
FRONTEND_PORT=5173
BACKEND_PORT=8080
POSTGRES_PORT=5432

# --- PostgreSQL ---
# Application role and database. The official image does not use the
# default "postgres" role name when POSTGRES_USER is set.
# The container process itself runs as the non-root OS user "postgres".
POSTGRES_USER=memo
POSTGRES_PASSWORD=memo_dev_password
POSTGRES_DB=memo

# --- Backend (host process: `go run ./cmd/server`) ---
# Compose overrides DB_HOST=db and DB_PORT=5432 inside the backend container.
# Keep localhost here so a server started on the host can reach the published port.
DB_HOST=localhost
DB_PORT=5432
DB_USER=memo
DB_PASSWORD=memo_dev_password
DB_NAME=memo
DB_SSLMODE=disable
HTTP_ADDR=:8080

# Browser origin allowed to call the API. Must match how you open the frontend.
# If you change FRONTEND_PORT, change this too.
CORS_ORIGIN=http://localhost:5173

# --- Frontend ---
# URL the browser uses to call the API. Use the published backend port.
# Do not use http://backend:8080 — the browser cannot resolve Compose DNS.
# If you change BACKEND_PORT, change this too, then recreate the frontend container.
VITE_API_BASE_URL=http://localhost:8080
